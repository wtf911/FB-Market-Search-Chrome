{
  "manifest_version": 3,
  "name": "Marketplace Description Search (free)",
  "version": "2.0.1",
  "description": "Search Facebook Marketplace by words in the listing DESCRIPTION, with scheduled keyword alerts.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/wtf911/FB-Market-Search-Chrome",
  "permissions": ["scripting", "storage", "alarms", "notifications", "idle", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marketplace Description Alerts",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["shared.js", "collector.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.css"], "matches": ["https://*.facebook.com/*"] }
  ]
}
